{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Studio",
  "version": "1.0.2",
  "identifier": "com.pdfstudio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "PDF Studio", "width": 1280, "height": 860, "minWidth": 720, "minHeight": 500, "dragDropEnabled": false }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Editor de PDF",
    "longDescription": "Ver, comentar, editar, rellenar, firmar con certificado, proteger y convertir PDF.",
    "fileAssociations": [
      { "ext": ["pdf"], "name": "Documento PDF", "description": "Documento PDF", "role": "Editor", "mimeType": "application/pdf" }
    ],
    "windows": { "nsis": { "languages": ["Spanish", "English"], "displayLanguageSelector": false } },
    "linux": { "deb": { "depends": ["opensc"] } }
  }
}
